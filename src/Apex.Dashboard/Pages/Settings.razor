@page "/settings"
@inject ApexApiClient Api

<div class="page-header">
    <h1 class="page-title">Settings</h1>
    <p class="page-subtitle">Configure agency gate thresholds and system behavior</p>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else if (_thresholds != null)
{
    <div class="card">
        <div class="card-title">Agency Gate Thresholds</div>
        <p class="text-sm text-muted mb-2">
            These thresholds control when APEX is allowed to take autonomous actions.
            Lowering below recommended values will trigger warnings.
        </p>

        <div class="threshold-grid">
            <ThresholdInput Label="Min Suggestions"
                            Description="Suggestions logged before agency activates"
                            @bind-Value="_minSuggestions"
                            Recommended="@_thresholds.RecommendedSuggestions"
                            InputType="int" />

            <ThresholdInput Label="Min Feedback Rate"
                            Description="Percentage of suggestions with explicit outcomes"
                            @bind-Value="_minFeedbackPct"
                            Recommended="@((int)(_thresholds.RecommendedFeedbackRate * 100))"
                            Suffix="%"
                            InputType="int" />

            <ThresholdInput Label="Min Anti-Pattern Suppressions"
                            Description="Anti-patterns detected before agency activates"
                            @bind-Value="_minSuppressions"
                            Recommended="@_thresholds.RecommendedSuppressions"
                            InputType="int" />

            <ThresholdInput Label="Min Consolidated Sessions"
                            Description="Sessions fully processed by consolidation pipeline"
                            @bind-Value="_minConsolidated"
                            Recommended="@_thresholds.RecommendedConsolidatedSessions"
                            InputType="int" />
        </div>

        @if (_warnings.Any())
        {
            <div class="mt-2" style="padding:0.75rem;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:0.375rem">
                <div class="text-warning text-sm" style="font-weight:600;margin-bottom:0.35rem">⚠ Below Recommended Thresholds</div>
                @foreach (var w in _warnings)
                {
                    <div class="text-sm" style="color:var(--text-secondary);margin-bottom:0.2rem">• @w</div>
                }
            </div>
        }

        <div class="flex gap-1 mt-2">
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? "Saving..." : "Save Thresholds")
            </button>
            <button class="btn" @onclick="ResetToRecommended">Reset to Recommended</button>
        </div>

        @if (_saved)
        {
            <div class="mt-1 text-success text-sm">✓ Thresholds updated successfully</div>
        }
    </div>
}

<style>
    .threshold-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 768px) {
        .threshold-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private ThresholdsDto? _thresholds;
    private int _minSuggestions;
    private int _minFeedbackPct;
    private int _minSuppressions;
    private int _minConsolidated;
    private bool _loading = true;
    private bool _saving;
    private bool _saved;

    private List<string> _warnings => GetWarnings();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _thresholds = await Api.GetThresholdsAsync();
            if (_thresholds != null)
            {
                _minSuggestions = _thresholds.MinSuggestions;
                _minFeedbackPct = (int)(_thresholds.MinFeedbackRate * 100);
                _minSuppressions = _thresholds.MinAntiPatternSuppressions;
                _minConsolidated = _thresholds.MinConsolidatedSessions;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        _loading = false;
    }

    private List<string> GetWarnings()
    {
        if (_thresholds == null) return [];
        var warnings = new List<string>();
        if (_minSuggestions < _thresholds.RecommendedSuggestions)
            warnings.Add($"Suggestions ({_minSuggestions}) is below recommended ({_thresholds.RecommendedSuggestions}). Agency may act on limited data.");
        if (_minFeedbackPct < (int)(_thresholds.RecommendedFeedbackRate * 100))
            warnings.Add($"Feedback rate ({_minFeedbackPct}%) is below recommended ({(int)(_thresholds.RecommendedFeedbackRate * 100)}%). Quality of autonomous actions may be lower.");
        if (_minSuppressions < _thresholds.RecommendedSuppressions)
            warnings.Add($"Anti-pattern suppressions ({_minSuppressions}) is below recommended ({_thresholds.RecommendedSuppressions}).");
        if (_minConsolidated < _thresholds.RecommendedConsolidatedSessions)
            warnings.Add($"Consolidated sessions ({_minConsolidated}) is below recommended ({_thresholds.RecommendedConsolidatedSessions}). Agency has limited learning history.");
        return warnings;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saved = false;
        StateHasChanged();

        try
        {
            _thresholds = await Api.UpdateThresholdsAsync(new UpdateThresholdsDto
            {
                MinSuggestions = _minSuggestions,
                MinFeedbackRate = _minFeedbackPct / 100.0,
                MinAntiPatternSuppressions = _minSuppressions,
                MinConsolidatedSessions = _minConsolidated
            });
            _saved = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Save error: {ex.Message}");
        }

        _saving = false;
    }

    private void ResetToRecommended()
    {
        if (_thresholds == null) return;
        _minSuggestions = _thresholds.RecommendedSuggestions;
        _minFeedbackPct = (int)(_thresholds.RecommendedFeedbackRate * 100);
        _minSuppressions = _thresholds.RecommendedSuppressions;
        _minConsolidated = _thresholds.RecommendedConsolidatedSessions;
        _saved = false;
    }
}
