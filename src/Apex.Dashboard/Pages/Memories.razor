@page "/memories"
@inject NavigationManager Nav
@inject ApexSignalRService SignalR

<div class="page-header">
    <h1 class="page-title">Memories</h1>
    <p class="page-subtitle">Knowledge extracted from coding sessions, plus the preferences and anti-patterns that feed context injection</p>
    <span class="badge @(SignalR.IsConnected ? "badge-success" : "badge-warning")" style="font-size:0.7rem">
        @(SignalR.IsConnected ? "● Live" : "○ Offline")
    </span>
</div>

<TabBar Tabs="Tabs" ActiveKey="@ActiveTab" ActiveKeyChanged="SelectTab" />

@if (ActiveTab == "preferences")
{
    <PreferencesPanel />
}
else if (ActiveTab == "antipatterns")
{
    <AntiPatternsPanel />
}
else
{
    <MemoriesListPanel />
}

@code {
    private const string DefaultTab = "memories";

    private static readonly TabItem[] Tabs =
    [
        new(DefaultTab, "Memories"),
        new("preferences", "Preferences"),
        new("antipatterns", "Anti-Patterns")
    ];

    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string ActiveTab => Tabs.Any(t => t.Key == Tab) ? Tab! : DefaultTab;

    private void SelectTab(string key) =>
        Nav.NavigateTo(key == DefaultTab ? "/memories" : $"/memories?tab={key}", replace: true);
}
