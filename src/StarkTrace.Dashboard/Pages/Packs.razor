@page "/packs"
@using StarkTrace.Dashboard.Services
@inject StarkTraceApiClient Api

<div class="page-header">
    <h1 class="page-title">Packs</h1>
    <p class="page-subtitle">Export project knowledge or import packs to bootstrap StarkTrace with curated data.</p>
</div>

@if (_error != null)
{
    <div class="alert-error">@_error</div>
}
@if (_success != null)
{
    <div class="alert-success">@_success</div>
}

<div class="packs-grid">

    <!-- Export Panel -->
    <div class="card">
        <div class="card-title">Export</div>
        <p class="text-sm text-muted" style="margin-bottom:1rem">Export a project's memories, preferences, and anti-patterns as a pack.</p>

        <label class="field-label">Project</label>
        <select @bind="_exportProject" class="select-input">
            <option value="">— Select project —</option>
            @foreach (var p in _projects)
            {
                <option value="@p.Name">@p.DisplayName (@p.Name)</option>
            }
        </select>

        <button @onclick="ExportAsync" disabled="@(string.IsNullOrEmpty(_exportProject) || _loading)" class="btn btn-primary">
            @(_loading ? "Exporting..." : "Export Pack")
        </button>

        @if (_exportedJson != null)
        {
            <div style="margin-top:1rem">
                <label class="field-label">Pack JSON <span class="text-muted" style="font-weight:400">(copy or download)</span></label>
                <textarea readonly class="code-area" style="height:200px">@_exportedJson</textarea>
                <button @onclick="CopyExportToClipboard" class="btn" style="margin-top:0.5rem">Copy</button>
            </div>
        }
    </div>

    <!-- Import Panel -->
    <div class="card">
        <div class="card-title">Import</div>
        <p class="text-sm text-muted" style="margin-bottom:1rem">Paste pack JSON to import memories, preferences, and anti-patterns.</p>

        <label class="field-label">Pack JSON</label>
        <textarea @bind="_importJson" placeholder="Paste pack JSON here..." class="code-area" style="height:120px"></textarea>

        <label class="field-label">Decryption Key <span class="text-muted" style="font-weight:400">(optional, for encrypted packs)</span></label>
        <input @bind="_decryptionKey" type="text" placeholder="Base64 key..." class="search-input" style="font-family:monospace;margin-bottom:0.75rem" />

        <label class="field-label">Target Project Override <span class="text-muted" style="font-weight:400">(optional)</span></label>
        <select @bind="_importTargetProject" class="select-input">
            <option value="">— Use pack default —</option>
            @foreach (var p in _projects)
            {
                <option value="@p.Name">@p.DisplayName (@p.Name)</option>
            }
        </select>

        <div class="flex gap-1">
            <button @onclick="ValidateAsync" disabled="@(string.IsNullOrEmpty(_importJson) || _loading)" class="btn">
                Validate
            </button>
            <button @onclick="ImportAsync" disabled="@(string.IsNullOrEmpty(_importJson) || _loading)" class="btn btn-success">
                @(_loading ? "Importing..." : "Import Pack")
            </button>
        </div>

        @if (_validationResult != null)
        {
            <div class="@(_validationResult.IsValid ? "alert-success" : "alert-error")" style="margin-top:0.75rem">
                @if (_validationResult.IsValid)
                {
                    <div><strong>Valid:</strong> @_validationResult.PackName (@_validationResult.PackId)</div>
                    <div class="text-sm">@_validationResult.MemoryCount memories, @_validationResult.PreferenceCount preferences, @_validationResult.AntiPatternCount anti-patterns</div>
                }
                else
                {
                    <div><strong>Invalid:</strong> @_validationResult.Error</div>
                }
            </div>
        }

        @if (_importResult != null)
        {
            <div class="@(_importResult.Success ? "alert-success" : "alert-error")" style="margin-top:0.75rem">
                @if (_importResult.Success)
                {
                    <div><strong>Imported:</strong> @_importResult.PackName</div>
                    <div class="text-sm">@_importResult.MemoriesImported memories, @_importResult.PreferencesImported preferences, @_importResult.AntiPatternsImported anti-patterns, @_importResult.DuplicatesSkipped skipped</div>
                }
                else
                {
                    <div><strong>Failed:</strong> @_importResult.Error</div>
                }
            </div>
        }
    </div>

</div>

<!-- Machine Info -->
<div class="card">
    <div class="card-title">Machine Info</div>
    <p class="text-sm"><strong>Machine ID:</strong> <code class="inline-code">@(_machineId ?? "loading...")</code></p>
</div>

<style>
    .packs-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .packs-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    private List<ProjectDto> _projects = [];
    private string? _error;
    private string? _success;
    private bool _loading;

    private string _exportProject = "";
    private string? _exportedJson;

    private string _importJson = "";
    private string _decryptionKey = "";
    private string _importTargetProject = "";
    private PackValidationResultDto? _validationResult;
    private PackImportResultDto? _importResult;

    private string? _machineId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await Api.GetProjectsAsync();
            _machineId = await Api.GetMachineIdAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ExportAsync()
    {
        _loading = true; _error = null; _success = null; _exportedJson = null;
        try
        {
            var pack = await Api.ExportPackAsync(_exportProject);
            if (pack != null)
            {
                _exportedJson = System.Text.Json.JsonSerializer.Serialize(pack,
                    new System.Text.Json.JsonSerializerOptions { WriteIndented = true, PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase });
                _success = $"Exported '{pack.Name}': {pack.Memories.Count} memories, {pack.Preferences.Count} preferences, {pack.AntiPatterns.Count} anti-patterns";
            }
            else { _error = "Export returned no data."; }
        }
        catch (Exception ex) { _error = $"Export failed: {ex.Message}"; }
        _loading = false;
    }

    private async Task ValidateAsync()
    {
        _loading = true; _error = null; _validationResult = null;
        try { _validationResult = await Api.ValidatePackAsync(_importJson); }
        catch (Exception ex) { _error = $"Validation failed: {ex.Message}"; }
        _loading = false;
    }

    private async Task ImportAsync()
    {
        _loading = true; _error = null; _success = null; _importResult = null;
        try
        {
            var key = string.IsNullOrWhiteSpace(_decryptionKey) ? null : _decryptionKey;
            var target = string.IsNullOrWhiteSpace(_importTargetProject) ? null : _importTargetProject;
            _importResult = await Api.ImportPackAsync(_importJson, key, target);
            if (_importResult?.Success == true)
                _success = $"Import complete: {_importResult.PackName}";
        }
        catch (Exception ex) { _error = $"Import failed: {ex.Message}"; }
        _loading = false;
    }

    private void CopyExportToClipboard()
    {
        _success = "Select the text in the box and copy with Ctrl+C";
    }
}
