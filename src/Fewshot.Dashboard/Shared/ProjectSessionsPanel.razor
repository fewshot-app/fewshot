@inject FewshotApiClient Api
@inject FewshotSignalRService SignalR
@implements IDisposable

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else if (!Filtered.Any())
{
    <div class="card"><p class="text-muted">No sessions@(Project is null ? "" : " for this project").</p></div>
}
else
{
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    @if (Project is null)
                    {
                        <th>Project</th>
                    }
                    <th>Started</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Summary</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Filtered.OrderByDescending(s => s.StartTime).Take(MaxRows ?? int.MaxValue))
                {
                    <tr class="@(_highlightedId == s.SessionId ? "row-highlight" : "")">
                        <td>@s.SessionId</td>
                        @if (Project is null)
                        {
                            <td class="text-sm">@s.Project</td>
                        }
                        <td class="text-sm">@s.StartTime.ToString("MMM dd HH:mm")</td>
                        <td class="text-sm text-muted">
                            @if (s.EndTime.HasValue)
                            {
                                @((s.EndTime.Value - s.StartTime).ToString(@"h\hmm\m"))
                            }
                            else
                            {
                                <span class="text-info">Active</span>
                            }
                        </td>
                        <td>
                            @if (s.IsConsolidated && s.ConsolidationError == null)
                            {
                                <span class="badge badge-success">Consolidated</span>
                            }
                            else if (s.ConsolidationError != null)
                            {
                                <span class="badge badge-danger">Failed</span>
                            }
                            else if (s.EndTime.HasValue)
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                            else
                            {
                                <span class="badge badge-info">Active</span>
                            }
                        </td>
                        <td class="text-sm">
                            @if (!string.IsNullOrEmpty(s.ConsolidationSummary))
                            {
                                @s.ConsolidationSummary
                            }
                            else if (!string.IsNullOrEmpty(s.ConsolidationError))
                            {
                                <span class="text-danger">@s.ConsolidationError</span>
                            }
                        </td>
                        <td class="session-actions">
                            <select class="session-project-select" title="Reassign project"
                                    value="@(s.Project ?? "")"
                                    @onchange="e => ReassignAsync(s, e.Value?.ToString())">
                                @foreach (var name in ProjectOptions(s))
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>
                            @if (s.EndTime.HasValue)
                            {
                                <button class="btn btn-xs" disabled="@(_busyId == s.SessionId)"
                                        @onclick="() => RerunAsync(s.SessionId)">
                                    @(_busyId == s.SessionId ? "…" : "Re-run")
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .session-actions {
        white-space: nowrap;
        text-align: right;
    }
    .session-project-select {
        background: var(--bg-primary);
        border: 1px solid var(--border);
        border-radius: 0.25rem;
        color: var(--text-primary);
        font-size: 0.75rem;
        padding: 0.15rem 0.3rem;
        margin-right: 0.4rem;
        max-width: 9rem;
    }
    .btn-xs {
        font-size: 0.7rem;
        padding: 0.15rem 0.5rem;
    }
    .row-highlight {
        animation: highlight-fade 2s ease-out;
    }
    @@keyframes highlight-fade {
        0% { background-color: rgba(99, 102, 241, 0.25); }
        100% { background-color: transparent; }
    }
</style>

@code {
    [Parameter] public string? Project { get; set; }
    [Parameter] public int? MaxRows { get; set; }

    private List<SessionDto> _sessions = [];
    private List<ProjectDto> _projects = [];
    private bool _loading = true;
    private int? _highlightedId;
    private int? _busyId;

    private IEnumerable<SessionDto> Filtered =>
        Project is null ? _sessions : _sessions.Where(s => string.Equals(s.Project, Project, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        _sessions = await Api.GetSessionsAsync();
        _projects = await Api.GetProjectsAsync();
        _loading = false;
        SignalR.OnSessionUpdate += HandleSessionUpdate;
        SignalR.OnStateChanged += HandleStateChanged;
    }

    private void HandleSessionUpdate(int sessionId, string status, string summary)
    {
        InvokeAsync(async () =>
        {
            var updated = await Api.GetSessionAsync(sessionId);
            if (updated != null)
            {
                var idx = _sessions.FindIndex(s => s.SessionId == sessionId);
                if (idx >= 0)
                    _sessions[idx] = updated;
                else
                    _sessions.Insert(0, updated);
            }

            _highlightedId = sessionId;
            StateHasChanged();

            await Task.Delay(2100);
            _highlightedId = null;
            StateHasChanged();
        });
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private IEnumerable<string> ProjectOptions(SessionDto s)
    {
        var names = _projects.Select(p => p.Name).ToList();
        // Keep the current value selectable even if it isn't a registered project (e.g. "general")
        if (!string.IsNullOrEmpty(s.Project) && !names.Contains(s.Project, StringComparer.OrdinalIgnoreCase))
            names.Insert(0, s.Project);
        return names.OrderBy(n => n, StringComparer.OrdinalIgnoreCase);
    }

    private async Task ReassignAsync(SessionDto s, string? project)
    {
        if (string.IsNullOrWhiteSpace(project) ||
            string.Equals(project, s.Project, StringComparison.OrdinalIgnoreCase)) return;

        var updated = await Api.ReassignSessionProjectAsync(s.SessionId, project);
        if (updated != null)
        {
            var idx = _sessions.FindIndex(x => x.SessionId == s.SessionId);
            if (idx >= 0) _sessions[idx] = updated;
            StateHasChanged();
        }
    }

    private async Task RerunAsync(int sessionId)
    {
        _busyId = sessionId;
        StateHasChanged();

        if (await Api.RerunConsolidationAsync(sessionId))
        {
            // Optimistically show Pending; SignalR pushes the real result when the job lands
            var idx = _sessions.FindIndex(x => x.SessionId == sessionId);
            if (idx >= 0)
                _sessions[idx] = _sessions[idx] with { IsConsolidated = false, ConsolidationSummary = null, ConsolidationError = null };
        }

        _busyId = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        SignalR.OnSessionUpdate -= HandleSessionUpdate;
        SignalR.OnStateChanged -= HandleStateChanged;
    }
}
