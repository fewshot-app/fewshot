@page "/experiments"
@inject ApexApiClient Api

<div class="page-header">
    <h1 class="page-title">A/B Experiments</h1>
    <p class="page-subtitle">ACL vs Prose format token efficiency per context tier</p>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else if (_results.Any())
{
    <div class="card">
        <table class="table">
            <thead>
                <tr>
                    <th>Tier</th>
                    <th>Format</th>
                    <th>Avg Tokens</th>
                    <th>Sessions</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in _results.GroupBy(r => r.Tier))
                {
                    var acl = group.FirstOrDefault(r => r.Format == "ACL");
                    var prose = group.FirstOrDefault(r => r.Format == "Prose");
                    var winner = acl != null && prose != null && (acl.AvgTokens + prose.AvgTokens) > 0
                        ? (acl.AvgTokens < prose.AvgTokens ? "ACL" : acl.AvgTokens > prose.AvgTokens ? "Prose" : null)
                        : null;

                    @foreach (var r in group)
                    {
                        <tr>
                            <td><strong>@r.Tier</strong></td>
                            <td>@r.Format</td>
                            <td>@r.AvgTokens</td>
                            <td class="text-muted">@r.SessionCount</td>
                            <td>
                                @if (r.Format == winner)
                                {
                                    <span class="badge badge-success">Winner</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="card"><p class="text-muted">No experiment data yet. Run some sessions with context injection to generate results.</p></div>
}

@code {
    private List<TokenResultDto> _results = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { _results = await Api.GetTokenResultsAsync(); }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
        _loading = false;
    }
}
