<div class="tabbar">
    @foreach (var tab in Tabs)
    {
        <button type="button" class="tab @(tab.Key == ActiveKey ? "active" : "")" @onclick="() => Select(tab.Key)">
            @tab.Label
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TabItem> Tabs { get; set; } = [];
    [Parameter] public string? ActiveKey { get; set; }
    [Parameter] public EventCallback<string> ActiveKeyChanged { get; set; }

    private Task Select(string key) =>
        key == ActiveKey ? Task.CompletedTask : ActiveKeyChanged.InvokeAsync(key);
}
