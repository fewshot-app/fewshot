<div class="flex items-center justify-between mb-1" style="gap:1rem">
    <span class="text-sm">@Label</span>
    <span class="text-sm @(Current >= Required ? "text-success" : "text-muted")">
        @Current@Suffix / @Required@Suffix
    </span>
</div>
<div class="progress mb-2">
    <div class="progress-bar @(Pct >= 100 ? "progress-bar-success" : Pct >= 60 ? "progress-bar-warning" : "progress-bar-danger")"
         style="width: @Math.Min(Pct, 100)%"></div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int Current { get; set; }
    [Parameter] public int Required { get; set; }
    [Parameter] public string Suffix { get; set; } = "";

    private int Pct => Required > 0 ? (int)((double)Current / Required * 100) : 0;
}
