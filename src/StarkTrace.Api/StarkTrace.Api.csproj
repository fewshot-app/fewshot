<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.23" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Hangfire.InMemory" Version="0.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.23" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.23">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarkTrace.Core\StarkTrace.Core.csproj" />
    <ProjectReference Include="..\StarkTrace.Infrastructure\StarkTrace.Infrastructure.csproj" />
    <ProjectReference Include="..\StarkTrace.Dashboard\StarkTrace.Dashboard.csproj" ReferenceOutputAssembly="false" UndefineProperties="PublishSingleFile;IncludeNativeLibrariesForSelfExtract;SelfContained;RuntimeIdentifier" />
  </ItemGroup>

  <Target Name="CopyDashboardWwwroot" AfterTargets="Build">
    <ItemGroup>
      <DashboardBuildFiles Include="$(MSBuildThisFileDirectory)..\StarkTrace.Dashboard\bin\$(Configuration)\net8.0\wwwroot\**\*" />
      <DashboardSourceFiles Include="$(MSBuildThisFileDirectory)..\StarkTrace.Dashboard\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DashboardBuildFiles)"
          DestinationFiles="@(DashboardBuildFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DashboardSourceFiles)"
          DestinationFiles="@(DashboardSourceFiles->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
