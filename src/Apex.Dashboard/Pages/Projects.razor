@page "/projects"
@inject ApexApiClient Api

<div class="page-header">
    <h1 class="page-title">Projects</h1>
    <p class="page-subtitle">Manage project definitions used for keyword-based session routing</p>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else
{
    <!-- Add New Project -->
    <div class="card mb-2">
        <div class="card-title">
            <span style="cursor:pointer" @onclick="ToggleAddForm">
                @(_showAddForm ? "▾" : "▸") Add Project
            </span>
        </div>

        @if (_showAddForm)
        {
            <div class="form-grid">
                <div class="form-row">
                    <label class="form-label">Internal Name <span class="text-muted text-sm">(slug, lowercase)</span></label>
                    <input class="search-input" placeholder="e.g. myproject" @bind="_addName" />
                </div>
                <div class="form-row">
                    <label class="form-label">Display Name</label>
                    <input class="search-input" placeholder="e.g. My Project" @bind="_addDisplayName" />
                </div>
                <div class="form-row">
                    <label class="form-label">Keywords <span class="text-muted text-sm">(comma-separated, used for routing)</span></label>
                    <input class="search-input" placeholder="e.g. myproject, widget, react" @bind="_addKeywords" />
                </div>
                <div class="form-row">
                    <label class="form-label">Facts <span class="text-muted text-sm">(optional, injected as context)</span></label>
                    <textarea class="search-input" rows="3" placeholder="Key facts about this project..." @bind="_addFacts" style="resize:vertical"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_addError))
                {
                    <div class="text-danger text-sm">@_addError</div>
                }
                <div class="flex gap-1 mt-1">
                    <button class="btn btn-primary" @onclick="AddProjectAsync" disabled="@_saving">
                        @(_saving ? "Saving..." : "Add Project")
                    </button>
                    <button class="btn" @onclick="CancelAdd">Cancel</button>
                </div>
            </div>
        }
    </div>

    <!-- Project Cards -->
    @if (!_projects.Any())
    {
        <div class="card"><p class="text-muted">No projects defined. Add one above.</p></div>
    }
    else
    {
        @foreach (var p in _projects.OrderBy(p => p.DisplayName))
        {
            <div class="card @(!p.IsActive ? "project-inactive" : "")">
                @if (_editingId == p.ProjectId)
                {
                    <!-- Edit Mode -->
                    <div class="form-grid">
                        <div class="flex justify-between items-center mb-1">
                            <strong class="text-sm text-muted">Editing: @p.Name</strong>
                            <label class="flex items-center gap-1 text-sm" style="cursor:pointer">
                                <input type="checkbox" @bind="_editIsActive" />
                                Active
                            </label>
                        </div>
                        <div class="form-row">
                            <label class="form-label">Display Name</label>
                            <input class="search-input" @bind="_editDisplayName" />
                        </div>
                        <div class="form-row">
                            <label class="form-label">Keywords</label>
                            <input class="search-input" placeholder="comma-separated" @bind="_editKeywords" />
                        </div>
                        <div class="form-row">
                            <label class="form-label">Facts</label>
                            <textarea class="search-input" rows="3" @bind="_editFacts" style="resize:vertical"></textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(_editError))
                        {
                            <div class="text-danger text-sm">@_editError</div>
                        }
                        <div class="flex gap-1 mt-1">
                            <button class="btn btn-primary" @onclick="() => SaveEditAsync(p.ProjectId, p.Name)" disabled="@_saving">
                                @(_saving ? "Saving..." : "Save")
                            </button>
                            <button class="btn" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- View Mode -->
                    <div class="flex justify-between items-start">
                        <div style="flex:1">
                            <div class="flex items-center gap-1 mb-1">
                                <strong>@p.DisplayName</strong>
                                <span class="tag text-sm">@p.Name</span>
                                @if (!p.IsActive)
                                {
                                    <span class="badge badge-muted">Inactive</span>
                                }
                            </div>

                            <div class="flex flex-wrap gap-1 mb-1">
                                @foreach (var kw in p.Keywords.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="tag">@kw</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(p.Facts))
                            {
                                <p class="text-sm text-muted" style="white-space:pre-wrap;margin-top:0.25rem">@p.Facts</p>
                            }

                            <span class="text-sm text-muted">Added @p.CreatedAt.ToString("MMM dd, yyyy")</span>
                        </div>

                        <div class="flex gap-1" style="margin-left:1rem;flex-shrink:0">
                            @if (_confirmDeleteId == p.ProjectId)
                            {
                                <span class="text-sm text-danger" style="line-height:2rem">Sure?</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteAsync(p.ProjectId)">Yes</button>
                                <button class="btn btn-sm" @onclick="CancelDelete">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm" @onclick="() => StartEdit(p)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => RequestDelete(p.ProjectId)">Delete</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
}

<style>
    .form-grid { display: flex; flex-direction: column; gap: 0.75rem; }
    .form-row { display: flex; flex-direction: column; gap: 0.25rem; }
    .form-label { font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); }
    .project-inactive { opacity: 0.6; border-left: 3px solid var(--border); }
    textarea.search-input { font-family: inherit; font-size: 0.875rem; }
</style>

@code {
    private List<ProjectDto> _projects = [];
    private bool _loading = true;
    private bool _saving;

    // Add form
    private bool _showAddForm;
    private string _addName = "";
    private string _addDisplayName = "";
    private string _addKeywords = "";
    private string _addFacts = "";
    private string _addError = "";

    // Edit
    private int? _editingId;
    private string _editDisplayName = "";
    private string _editKeywords = "";
    private string _editFacts = "";
    private bool _editIsActive = true;
    private string _editError = "";

    // Delete
    private int? _confirmDeleteId;

    protected override async Task OnInitializedAsync()
    {
        _projects = await Api.GetProjectsAsync();
        _loading = false;
    }

    // ── Add ──────────────────────────────────────────
    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        _addError = "";
    }

    private void CancelAdd()
    {
        _showAddForm = false;
        _addName = _addDisplayName = _addKeywords = _addFacts = _addError = "";
    }

    private async Task AddProjectAsync()
    {
        _addError = "";
        if (string.IsNullOrWhiteSpace(_addName)) { _addError = "Internal name is required."; return; }
        if (string.IsNullOrWhiteSpace(_addDisplayName)) { _addError = "Display name is required."; return; }
        if (string.IsNullOrWhiteSpace(_addKeywords)) { _addError = "At least one keyword is required."; return; }

        _saving = true;
        try
        {
            var created = await Api.CreateProjectAsync(new ProjectUpsertDto(
                _addName.ToLowerInvariant().Trim(),
                _addDisplayName.Trim(),
                _addKeywords.Trim(),
                string.IsNullOrWhiteSpace(_addFacts) ? null : _addFacts.Trim()));

            if (created != null) _projects.Add(created);
            CancelAdd();
        }
        catch (Exception ex)
        {
            _addError = $"Error: {ex.Message}";
        }
        _saving = false;
    }

    // ── Edit ─────────────────────────────────────────
    private void StartEdit(ProjectDto p)
    {
        _editingId = p.ProjectId;
        _editDisplayName = p.DisplayName;
        _editKeywords = p.Keywords;
        _editFacts = p.Facts ?? "";
        _editIsActive = p.IsActive;
        _editError = "";
        _confirmDeleteId = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editError = "";
    }

    private async Task SaveEditAsync(int id, string name)
    {
        _editError = "";
        if (string.IsNullOrWhiteSpace(_editDisplayName)) { _editError = "Display name is required."; return; }
        if (string.IsNullOrWhiteSpace(_editKeywords)) { _editError = "At least one keyword is required."; return; }

        _saving = true;
        try
        {
            var updated = await Api.UpdateProjectAsync(id, new ProjectUpsertDto(
                name,
                _editDisplayName.Trim(),
                _editKeywords.Trim(),
                string.IsNullOrWhiteSpace(_editFacts) ? null : _editFacts.Trim(),
                _editIsActive));

            if (updated != null)
            {
                var idx = _projects.FindIndex(p => p.ProjectId == id);
                if (idx >= 0) _projects[idx] = updated;
            }
            CancelEdit();
        }
        catch (Exception ex)
        {
            _editError = $"Error: {ex.Message}";
        }
        _saving = false;
    }

    // ── Delete ───────────────────────────────────────
    private void RequestDelete(int id)
    {
        _confirmDeleteId = id;
        _editingId = null;
    }

    private void CancelDelete() => _confirmDeleteId = null;

    private async Task ConfirmDeleteAsync(int id)
    {
        try
        {
            await Api.DeleteProjectAsync(id);
            _projects = _projects.Where(p => p.ProjectId != id).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete error: {ex.Message}");
        }
        _confirmDeleteId = null;
    }
}
