@inject ApexApiClient Api
@inject ApexSignalRService SignalR

<!-- Search -->
<div class="card mb-2">
    <div class="card-title">Search Memories</div>
    <div class="flex gap-1">
        <input class="search-input" style="flex:1" placeholder="Search semantically..."
               @bind="_query" @onkeydown="HandleKey" />
        <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_searching">Search</button>
        @if (_isFiltered)
        {
            <button class="btn" @onclick="ClearSearch">Clear</button>
        }
    </div>
</div>

@if (_loading)
{
    <div class="loading">Loading memories...</div>
}
else if (_searching)
{
    <div class="loading">Searching...</div>
}
else
{
    <div class="card">
        <div class="flex justify-between items-center mb-2">
            <div class="card-title" style="margin:0">
                @if (_isFiltered)
                {
                    <span>Results for "@_lastQuery" (@_displayMemories.Count)</span>
                }
                else
                {
                    <span>All Memories (@_displayMemories.Count)</span>
                }
            </div>
        </div>

        @if (!_displayMemories.Any())
        {
            <p class="text-muted">
                @(_isFiltered ? "No memories found matching your query." : "No memories stored yet. Complete sessions will be consolidated overnight.")
            </p>
        }
        else
        {
            @foreach (var m in _displayMemories)
            {
                <div class="memory-card @(_deletingId == m.PointId ? "deleting" : "")">
                    <div class="flex justify-between items-start mb-1">
                        <strong style="flex:1;padding-right:1rem">@m.Summary</strong>
                        <div class="flex items-center gap-1">
                            @if (m.RelevanceScore.HasValue)
                            {
                                <span class="score @ScoreClass(m.RelevanceScore.Value)">
                                    @m.RelevanceScore.Value.ToString("F2")
                                </span>
                            }
                            @if (_confirmDeleteId == m.PointId)
                            {
                                <span class="text-sm text-danger" style="white-space:nowrap">Sure?</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteAsync(m)">Yes</button>
                                <button class="btn btn-sm" @onclick="CancelDelete">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => RequestDelete(m.PointId)">Delete</button>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(m.Solution))
                    {
                        <p class="text-sm text-muted mb-1">@m.Solution</p>
                    }

                    <div class="flex flex-wrap gap-1 mb-1">
                        @if (!string.IsNullOrEmpty(m.OutcomeLabel))
                        {
                            <span class="badge @OutcomeBadge(m.OutcomeLabel)">@m.OutcomeLabel</span>
                        }
                        @if (!string.IsNullOrEmpty(m.Language))
                        {
                            <span class="tag">@m.Language</span>
                        }
                        @if (!string.IsNullOrEmpty(m.Project))
                        {
                            <span class="tag">@m.Project</span>
                        }
                        @if (!string.IsNullOrEmpty(m.Tags))
                        {
                            @foreach (var tag in m.Tags.Split(',', StringSplitOptions.TrimEntries))
                            {
                                <span class="tag">@tag</span>
                            }
                        }
                    </div>

                    <span class="text-sm text-muted">Session @m.SessionId · @m.CreatedAt.ToString("MMM dd HH:mm")</span>
                </div>
            }
        }
    </div>
}

<style>
    .memory-card {
        padding: 0.75rem;
        margin-bottom: 0.75rem;
        border-left: 3px solid var(--accent);
        border-radius: 0.375rem;
        background: var(--surface);
        transition: opacity 0.3s ease;
    }
    .memory-card.deleting {
        opacity: 0.4;
        pointer-events: none;
    }
    .memory-card:last-child { margin-bottom: 0; }
</style>

@code {
    private string _query = "";
    private string _lastQuery = "";
    private List<MemoryDto> _allMemories = [];
    private List<MemoryDto> _displayMemories = [];
    private bool _loading = true;
    private bool _searching;
    private bool _isFiltered;
    private string? _confirmDeleteId;
    private string? _deletingId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sessions = await Api.GetSessionsAsync();
            _allMemories = await Api.GetAllMemoriesAsync(sessions);
            _displayMemories = _allMemories;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Load error: {ex.Message}");
        }
        _loading = false;
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            ClearSearch();
            return;
        }

        _searching = true;
        _confirmDeleteId = null;
        StateHasChanged();

        try
        {
            _displayMemories = await Api.SearchMemoriesAsync(_query);
            _lastQuery = _query;
            _isFiltered = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            _displayMemories = [];
        }

        _searching = false;
    }

    private void ClearSearch()
    {
        _query = "";
        _lastQuery = "";
        _isFiltered = false;
        _confirmDeleteId = null;
        _displayMemories = _allMemories;
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
        if (e.Key == "Escape") ClearSearch();
    }

    private void RequestDelete(string pointId)
    {
        _confirmDeleteId = pointId;
    }

    private void CancelDelete()
    {
        _confirmDeleteId = null;
    }

    private async Task ConfirmDeleteAsync(MemoryDto memory)
    {
        _deletingId = memory.PointId;
        _confirmDeleteId = null;
        StateHasChanged();

        try
        {
            await Api.DeleteMemoryAsync(memory.PointId);
            // Remove from both lists to keep state in sync
            _allMemories.Remove(memory);
            _displayMemories.Remove(memory);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete error: {ex.Message}");
        }

        _deletingId = null;
    }

    private static string ScoreClass(double score) =>
        score > 0.7 ? "text-success" : score > 0.55 ? "text-warning" : "text-muted";

    private static string OutcomeBadge(string label) => label switch
    {
        "Worked" => "badge-success",
        "Failed" => "badge-danger",
        _ => "badge-muted"
    };
}
