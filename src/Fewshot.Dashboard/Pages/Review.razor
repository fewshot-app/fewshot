@page "/review/{DraftId}"
@inject FewshotApiClient Api
@implements IDisposable

<div class="page-header">
    <h1 class="page-title">Review: @(_pack?.Name ?? DraftId)</h1>
    <p class="page-subtitle">Approve what ships, edit what's close, reject the noise. Progress saves automatically.</p>
</div>

@if (_finalJson is not null)
{
    <div class="card" style="margin-bottom:1rem">
        <div class="card-title">Finalized pack</div>
        <p class="text-sm text-muted">Approved content only, version bumped. Copy this JSON and encrypt it with fewshot-pack.</p>
        <textarea readonly class="code-area" style="width:100%;height:240px">@_finalJson</textarea>
    </div>
}
else if (_pack is null)
{
    <div class="card">Loading draft…</div>
}
else
{
    <div class="card" style="margin-bottom:1rem">
        <div style="display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap">
            <div><strong style="color:#22c55e">@Approved</strong> <span class="text-muted">approved</span></div>
            <div><strong style="color:#ef4444">@Rejected</strong> <span class="text-muted">rejected</span></div>
            <div><strong>@Pending</strong> <span class="text-muted">pending</span></div>
            <div style="flex:1;min-width:160px;height:8px;background:rgba(148,163,184,0.2);border-radius:4px;overflow:hidden">
                <div style="height:100%;width:@ProgressPct%;background:#22c55e"></div>
            </div>
            @if (_saving)
            {
                <span class="text-sm text-muted">saving…</span>
            }
            <button class="btn btn-primary" disabled="@(Pending > 0 && !_finalizeAnyway)" @onclick="FinalizeAsync">Finalize</button>
        </div>
        @if (Pending > 0)
        {
            <label class="text-sm text-muted" style="display:block;margin-top:0.5rem">
                <input type="checkbox" @bind="_finalizeAnyway" /> allow finalize with @Pending pending (pending items are dropped)
            </label>
        }
    </div>

    <div style="display:flex;gap:0.5rem;margin-bottom:1rem;flex-wrap:wrap">
        @foreach (var f in StatusFilters)
        {
            var filter = f;
            <button class="btn @(_statusFilter == filter ? "btn-primary" : "")" @onclick="() => SetStatusFilter(filter)">@filter</button>
        }
        <span style="width:1rem"></span>
        @foreach (var k in KindFilters)
        {
            var kind = k;
            <button class="btn @(_kindFilter == kind ? "btn-primary" : "")" @onclick="() => SetKindFilter(kind)">@kind (@KindCount(kind))</button>
        }
    </div>

    @if (_kindFilter == "memories")
    {
        @foreach (var m in FilteredMemories.Take(_visible))
        {
            var mem = m;
            <div class="card" style="margin-bottom:0.75rem;@RowStyle(mem.ReviewStatus)">
                @if (_editing == mem)
                {
                    <input class="select-input" style="width:100%;margin-bottom:0.5rem" @bind="mem.Summary" />
                    <textarea class="code-area" style="width:100%;height:180px" @bind="mem.Solution"></textarea>
                }
                else
                {
                    <div class="card-title">@mem.Summary</div>
                    <div class="text-sm" style="white-space:pre-wrap;overflow:hidden;@(_expanded.Contains(mem) ? "" : "max-height:9rem")">@mem.Solution</div>
                    @if ((mem.Solution?.Length ?? 0) > 400)
                    {
                        <a style="cursor:pointer;color:#60a5fa" class="text-sm" @onclick="() => ToggleExpand(mem)">@(_expanded.Contains(mem) ? "less" : "more…")</a>
                    }
                    @if (!string.IsNullOrEmpty(mem.Approach))
                    {
                        <div class="text-sm text-muted" style="margin-top:0.4rem">@mem.Approach</div>
                    }
                }
                <div style="display:flex;gap:0.5rem;margin-top:0.6rem;align-items:center">
                    <button class="btn" style="color:#22c55e" @onclick="() => ApproveMemory(mem)">✓ Approve</button>
                    <button class="btn" @onclick="() => ToggleEditMemory(mem)">✎ @(_editing == mem ? "Done" : "Edit")</button>
                    <button class="btn" style="color:#ef4444" @onclick="() => RejectMemory(mem)">✕ Reject</button>
                    <span class="text-sm text-muted" style="margin-left:auto">@mem.Language</span>
                </div>
            </div>
        }
        @if (FilteredMemories.Count() > _visible)
        {
            <button class="btn" @onclick="ShowMore">Show more (@(FilteredMemories.Count() - _visible) remaining)</button>
        }
    }
    else if (_kindFilter == "preferences")
    {
        @foreach (var p in FilteredPreferences)
        {
            var pref = p;
            <div class="card" style="margin-bottom:0.75rem;@RowStyle(pref.ReviewStatus)">
                <div class="card-title">@pref.Category / @pref.Key</div>
                @if (_editingPref == pref)
                {
                    <textarea class="code-area" style="width:100%;height:80px" @bind="pref.Value"></textarea>
                }
                else
                {
                    <div class="text-sm" style="white-space:pre-wrap">@pref.Value</div>
                }
                <div style="display:flex;gap:0.5rem;margin-top:0.6rem">
                    <button class="btn" style="color:#22c55e" @onclick="() => ApprovePref(pref)">✓ Approve</button>
                    <button class="btn" @onclick="() => ToggleEditPref(pref)">✎ @(_editingPref == pref ? "Done" : "Edit")</button>
                    <button class="btn" style="color:#ef4444" @onclick="() => RejectPref(pref)">✕ Reject</button>
                </div>
            </div>
        }
    }
    else
    {
        @foreach (var a in FilteredAntiPatterns)
        {
            var anti = a;
            <div class="card" style="margin-bottom:0.75rem;@RowStyle(anti.ReviewStatus)">
                @if (_editingAnti == anti)
                {
                    <input class="select-input" style="width:100%;margin-bottom:0.5rem" @bind="anti.Pattern" />
                    <textarea class="code-area" style="width:100%;height:80px" @bind="anti.Reason"></textarea>
                }
                else
                {
                    <div class="card-title">⚠ @anti.Pattern</div>
                    <div class="text-sm" style="white-space:pre-wrap">@anti.Reason</div>
                }
                <div style="display:flex;gap:0.5rem;margin-top:0.6rem">
                    <button class="btn" style="color:#22c55e" @onclick="() => ApproveAnti(anti)">✓ Approve</button>
                    <button class="btn" @onclick="() => ToggleEditAnti(anti)">✎ @(_editingAnti == anti ? "Done" : "Edit")</button>
                    <button class="btn" style="color:#ef4444" @onclick="() => RejectAnti(anti)">✕ Reject</button>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public string DraftId { get; set; } = "";

    private static readonly string[] StatusFilters = ["pending", "approved", "rejected", "all"];
    private static readonly string[] KindFilters = ["memories", "preferences", "anti-patterns"];

    private FewshotPack? _pack;
    private string? _finalJson;
    private string _statusFilter = "pending";
    private string _kindFilter = "memories";
    private int _visible = 50;
    private bool _saving;
    private bool _finalizeAnyway;
    private PackMemory? _editing;
    private PackPreference? _editingPref;
    private PackAntiPattern? _editingAnti;
    private readonly HashSet<PackMemory> _expanded = [];
    private System.Timers.Timer? _saveTimer;

    private int Total => _pack is null ? 0 : _pack.Memories.Count + _pack.Preferences.Count + _pack.AntiPatterns.Count;
    private int Approved => _pack is null ? 0 : _pack.Memories.Count(x => x.ReviewStatus == "approved") + _pack.Preferences.Count(x => x.ReviewStatus == "approved") + _pack.AntiPatterns.Count(x => x.ReviewStatus == "approved");
    private int Rejected => _pack is null ? 0 : _pack.Memories.Count(x => x.ReviewStatus == "rejected") + _pack.Preferences.Count(x => x.ReviewStatus == "rejected") + _pack.AntiPatterns.Count(x => x.ReviewStatus == "rejected");
    private int Pending => Total - Approved - Rejected;
    private int ProgressPct => Total == 0 ? 0 : (Approved + Rejected) * 100 / Total;

    private IEnumerable<PackMemory> FilteredMemories => (_pack?.Memories ?? []).Where(x => MatchStatus(x.ReviewStatus));
    private IEnumerable<PackPreference> FilteredPreferences => (_pack?.Preferences ?? []).Where(x => MatchStatus(x.ReviewStatus));
    private IEnumerable<PackAntiPattern> FilteredAntiPatterns => (_pack?.AntiPatterns ?? []).Where(x => MatchStatus(x.ReviewStatus));

    private bool MatchStatus(string? s) => _statusFilter switch
    {
        "all" => true,
        "pending" => s is null,
        _ => s == _statusFilter
    };

    private static string RowStyle(string? s) => s switch
    {
        "approved" => "border-left:3px solid #22c55e;",
        "rejected" => "border-left:3px solid #ef4444;opacity:0.55;",
        _ => ""
    };

    private int KindCount(string kind) => _pack is null ? 0 : kind switch
    {
        "memories" => _pack.Memories.Count,
        "preferences" => _pack.Preferences.Count,
        _ => _pack.AntiPatterns.Count
    };

    protected override async Task OnParametersSetAsync() =>
        _pack = await Api.GetPackDraftAsync(DraftId);

    private void SetStatusFilter(string f) { _statusFilter = f; _visible = 50; }
    private void SetKindFilter(string k) { _kindFilter = k; _visible = 50; }
    private void ShowMore() => _visible += 50;
    private void ToggleExpand(PackMemory m) { if (!_expanded.Remove(m)) _expanded.Add(m); }

    private void ApproveMemory(PackMemory m) { m.ReviewStatus = "approved"; if (_editing == m) _editing = null; QueueSave(); }
    private void RejectMemory(PackMemory m) { m.ReviewStatus = "rejected"; if (_editing == m) _editing = null; QueueSave(); }
    private void ToggleEditMemory(PackMemory m) { _editing = _editing == m ? null : m; if (_editing is null) QueueSave(); }

    private void ApprovePref(PackPreference p) { p.ReviewStatus = "approved"; if (_editingPref == p) _editingPref = null; QueueSave(); }
    private void RejectPref(PackPreference p) { p.ReviewStatus = "rejected"; if (_editingPref == p) _editingPref = null; QueueSave(); }
    private void ToggleEditPref(PackPreference p) { _editingPref = _editingPref == p ? null : p; if (_editingPref is null) QueueSave(); }

    private void ApproveAnti(PackAntiPattern a) { a.ReviewStatus = "approved"; if (_editingAnti == a) _editingAnti = null; QueueSave(); }
    private void RejectAnti(PackAntiPattern a) { a.ReviewStatus = "rejected"; if (_editingAnti == a) _editingAnti = null; QueueSave(); }
    private void ToggleEditAnti(PackAntiPattern a) { _editingAnti = _editingAnti == a ? null : a; if (_editingAnti is null) QueueSave(); }

    private void QueueSave()
    {
        if (_saveTimer is null)
        {
            _saveTimer = new System.Timers.Timer(1200) { AutoReset = false };
            _saveTimer.Elapsed += async (_, _) =>
            {
                if (_pack is null) return;
                _saving = true;
                await InvokeAsync(StateHasChanged);
                await Api.SavePackDraftAsync(DraftId, _pack);
                _saving = false;
                await InvokeAsync(StateHasChanged);
            };
        }
        _saveTimer.Stop();
        _saveTimer.Start();
    }

    private async Task FinalizeAsync()
    {
        if (_pack is null) return;
        await Api.SavePackDraftAsync(DraftId, _pack);
        _finalJson = await Api.FinalizePackDraftAsync(DraftId);
    }

    public void Dispose() => _saveTimer?.Dispose();
}
