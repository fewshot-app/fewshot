@page "/audit"
@inject ApexApiClient Api

<div class="page-header">
    <h1 class="page-title">Audit Scanner</h1>
    <p class="page-subtitle">Three-stage PII detection: Regex → Presidio → Shannon entropy</p>
</div>

<div class="card mb-2">
    <div class="card-title">Test Content</div>
    <textarea class="search-input" rows="5" placeholder="Paste content to scan for PII, secrets, or sensitive data..."
              @bind="_content" style="resize:vertical;font-family:monospace"></textarea>
    <div class="mt-1">
        <button class="btn btn-primary" @onclick="AnalyzeAsync" disabled="@_analyzing">
            @(_analyzing ? "Scanning..." : "Analyze")
        </button>
    </div>
</div>

@if (_error != null)
{
    <div class="card" style="border-left:3px solid var(--danger)">
        <p class="text-danger">@_error</p>
    </div>
}

@if (_result != null)
{
    <div class="card" style="border-left:3px solid @(VerdictColor())">
        <div class="flex justify-between items-center mb-1">
            <div class="card-title" style="margin:0">Result</div>
            <span class="badge @VerdictBadge()">@_result.Verdict</span>
        </div>
        <p class="text-sm text-muted mb-1">@_result.Findings.Count finding(s)</p>

        @if (_result.Findings.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Stage</th>
                        <th>Confidence</th>
                        <th>Match</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _result.Findings)
                    {
                        <tr>
                            <td><span class="badge badge-danger">@f.DetectedType</span></td>
                            <td class="text-sm">@f.Stage</td>
                            <td class="text-sm">@f.Confidence.ToString("P0")</td>
                            <td class="text-sm" style="font-family:monospace">
                                @if (f.Length > 0 && f.StartIndex + f.Length <= _content.Length)
                                {
                                    @_content.Substring(f.StartIndex, Math.Min(f.Length, 40))
                                    @(f.Length > 40 ? "..." : "")
                                }
                                else
                                {
                                    <span class="text-muted">char @f.StartIndex–@(f.StartIndex + f.Length)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (!string.IsNullOrEmpty(_result.RedactedContent))
        {
            <div class="mt-2">
                <div class="card-title">Redacted Output</div>
                <pre class="text-sm" style="background:var(--bg-primary);padding:0.75rem;border-radius:0.375rem;overflow-x:auto">@_result.RedactedContent</pre>
            </div>
        }
    </div>
}

<div class="card mt-2">
    <div class="card-title">Allowlist</div>
    <p class="text-sm text-muted mb-1">
        Regex patterns for known-safe content. Findings fully inside a matched region are suppressed across all stages.
    </p>

    @if (_allowlist == null)
    {
        <p class="text-muted text-sm">Loading...</p>
    }
    else
    {
        @if (_allowlist.Count > 0)
        {
            <table class="table">
                <thead>
                    <tr><th>Pattern</th><th style="width:6rem"></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in _allowlist)
                    {
                        <tr>
                            <td class="text-sm" style="font-family:monospace">@p</td>
                            <td><button class="btn btn-sm" @onclick="() => RemovePattern(p)">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted text-sm">No allowlist patterns configured.</p>
        }

        <div class="flex gap-1 mt-1" style="align-items:flex-start">
            <input class="search-input" style="flex:1;font-family:monospace" placeholder="New regex pattern..."
                   @bind="_newPattern" @bind:event="oninput" />
            <button class="btn" @onclick="AddPattern" disabled="@string.IsNullOrWhiteSpace(_newPattern)">Add</button>
        </div>
        @if (_patternError != null)
        {
            <p class="text-danger text-sm mt-1">@_patternError</p>
        }

        <div class="flex gap-1 mt-2 items-center">
            <button class="btn btn-primary" @onclick="SaveAllowlist" disabled="@(!_dirty || _savingAllowlist)">
                @(_savingAllowlist ? "Saving..." : "Save Allowlist")
            </button>
            @if (_allowlistSaved)
            {
                <span class="text-success text-sm">✓ Saved</span>
            }
        </div>
    }
</div>

@code {
    private string _content = "";
    private AuditResultDto? _result;
    private string? _error;
    private bool _analyzing;

    private List<string>? _allowlist;
    private string _newPattern = "";
    private string? _patternError;
    private bool _dirty;
    private bool _savingAllowlist;
    private bool _allowlistSaved;

    protected override async Task OnInitializedAsync()
    {
        try { _allowlist = await Api.GetAuditAllowlistAsync(); }
        catch { _allowlist = []; }
    }

    private void AddPattern()
    {
        _patternError = null;
        _allowlistSaved = false;
        var pattern = _newPattern.Trim();
        if (pattern.Length == 0) return;

        try { _ = new System.Text.RegularExpressions.Regex(pattern); }
        catch (ArgumentException ex)
        {
            _patternError = $"Invalid regex: {ex.Message}";
            return;
        }

        if (!_allowlist!.Contains(pattern))
        {
            _allowlist.Add(pattern);
            _dirty = true;
        }
        _newPattern = "";
    }

    private void RemovePattern(string pattern)
    {
        _allowlistSaved = false;
        if (_allowlist!.Remove(pattern))
            _dirty = true;
    }

    private async Task SaveAllowlist()
    {
        _savingAllowlist = true;
        _patternError = null;
        _allowlistSaved = false;
        StateHasChanged();

        var (patterns, error) = await Api.UpdateAuditAllowlistAsync(_allowlist!);
        if (error != null)
        {
            _patternError = $"Save failed: {error}";
        }
        else
        {
            _allowlist = patterns;
            _dirty = false;
            _allowlistSaved = true;
        }
        _savingAllowlist = false;
    }

    private async Task AnalyzeAsync()
    {
        if (string.IsNullOrWhiteSpace(_content)) return;
        _analyzing = true;
        _result = null;
        _error = null;
        StateHasChanged();

        try
        {
            _result = await Api.AnalyzeAsync(_content);
        }
        catch (Exception ex)
        {
            _error = $"Audit failed: {ex.Message}";
        }

        _analyzing = false;
    }

    private string VerdictColor() => _result?.Verdict switch
    {
        "Safe" => "var(--success)",
        "SafeWithRedaction" => "var(--warning)",
        "Blocked" => "var(--danger)",
        _ => "var(--border)"
    };

    private string VerdictBadge() => _result?.Verdict switch
    {
        "Safe" => "badge-success",
        "SafeWithRedaction" => "badge-warning",
        "Blocked" => "badge-danger",
        _ => "badge-muted"
    };
}
