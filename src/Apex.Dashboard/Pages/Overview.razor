@page "/"
@inject ApexApiClient Api
@inject ApexSignalRService SignalR
@implements IDisposable

<div class="page-header">
    <h1 class="page-title">APEX Dashboard</h1>
    <p class="page-subtitle">Adaptive Personalized EXperience — System Overview</p>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_sessions.Count</div>
            <div class="stat-label">Total Sessions</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_sessions.Count(s => s.IsConsolidated)</div>
            <div class="stat-label">Consolidated</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_preferences.Count</div>
            <div class="stat-label">Preferences</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_antiPatterns.Count</div>
            <div class="stat-label">Anti-Patterns</div>
        </div>
    </div>

    <!-- Agency Readiness -->
    <div class="card">
        <div class="card-title">Agency Readiness</div>
        @if (_readiness != null)
        {
            <div class="flex items-center gap-1 mb-2">
                @if (_readiness.IsReady)
                {
                    <span class="badge badge-success">READY</span>
                }
                else
                {
                    <span class="badge badge-warning">NOT READY</span>
                }
            </div>

            <GateProgress Label="Suggestions" Current="@_readiness.SuggestionsLogged" Required="@_readiness.SuggestionsRequired" />
            <GateProgress Label="Feedback Rate" Current="@((int)(_readiness.ExplicitFeedbackRate * 100))" Required="@((int)(_readiness.FeedbackRateRequired * 100))" Suffix="%" />
            <GateProgress Label="Anti-Pattern Suppressions" Current="@_readiness.AntiPatternSuppressions" Required="@_readiness.SuppressionsRequired" />
            <GateProgress Label="Consolidated Sessions" Current="@_readiness.ConsolidatedSessions" Required="@_readiness.ConsolidatedSessionsRequired" />

            @if (_readiness.Warnings?.Any() == true)
            {
                <div class="mt-2" style="padding:0.75rem;background:rgba(245,158,11,0.08);border:1px solid rgba(245,158,11,0.25);border-radius:0.375rem">
                    <div class="text-warning text-sm" style="font-weight:600;margin-bottom:0.35rem">⚠ Below Recommended Thresholds</div>
                    @foreach (var w in _readiness.Warnings)
                    {
                        <div class="text-sm" style="color:var(--text-secondary);margin-bottom:0.2rem">• @w</div>
                    }
                </div>
            }
        }
    </div>

    <!-- Recent Sessions -->
    <div class="card">
        <div class="card-title">Recent Sessions</div>
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Started</th>
                    <th>Status</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sessions.OrderByDescending(s => s.StartTime).Take(10))
                {
                    <tr>
                        <td>@s.SessionId</td>
                        <td class="text-sm text-muted">@s.StartTime.ToString("MMM dd HH:mm")</td>
                        <td>
                            @if (s.IsConsolidated)
                            {
                                <span class="badge badge-success">Consolidated</span>
                            }
                            else if (s.EndTime.HasValue)
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                            else
                            {
                                <span class="badge badge-info">Active</span>
                            }
                        </td>
                        <td class="text-sm">@(s.ConsolidationSummary?.Split('|').FirstOrDefault()?.Trim() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Health -->
    <div class="card">
        <div class="card-title">Service Health</div>
        @if (_health != null)
        {
            <div class="flex flex-wrap gap-1">
                @foreach (var svc in _health.GetServiceStatuses())
                {
                    <span class="badge @(svc.Value == "healthy" ? "badge-success" : svc.Value == "degraded" ? "badge-warning" : "badge-danger")">
                        @svc.Key: @svc.Value
                    </span>
                }
            </div>
        }
    </div>
}

@code {
    private List<SessionDto> _sessions = [];
    private List<PreferenceDto> _preferences = [];
    private List<AntiPatternDto> _antiPatterns = [];
    private AgencyReadinessDto? _readiness;
    private HealthStatus? _health;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = Api.GetSessionsAsync().ContinueWith(t => _sessions = t.Result);
            var t2 = Api.GetPreferencesAsync().ContinueWith(t => _preferences = t.Result);
            var t3 = Api.GetAntiPatternsAsync().ContinueWith(t => _antiPatterns = t.Result);
            var t4 = Api.GetReadinessAsync().ContinueWith(t => _readiness = t.Result);
            var t5 = Api.GetHealthAsync().ContinueWith(t => _health = t.Result);
            await Task.WhenAll(t1, t2, t3, t4, t5);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        _loading = false;

        SignalR.OnSessionUpdate += HandleSessionUpdate;
        SignalR.OnTaskUpdate += HandleTaskUpdate;
    }

    private void HandleSessionUpdate(int sessionId, string status, string summary)
    {
        InvokeAsync(async () =>
        {
            var updated = await Api.GetSessionAsync(sessionId);
            if (updated != null)
            {
                var idx = _sessions.FindIndex(s => s.SessionId == sessionId);
                if (idx >= 0) _sessions[idx] = updated;
                else _sessions.Insert(0, updated);
            }
            // Refresh readiness since consolidated session count changed
            _readiness = await Api.GetReadinessAsync();
            StateHasChanged();
        });
    }

    private void HandleTaskUpdate(int sessionId, string status, string detail)
    {
        InvokeAsync(async () =>
        {
            _readiness = await Api.GetReadinessAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SignalR.OnSessionUpdate -= HandleSessionUpdate;
        SignalR.OnTaskUpdate -= HandleTaskUpdate;
    }
}
