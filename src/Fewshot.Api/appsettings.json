{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "FewshotDb": "Data Source=%PROGRAMDATA%\\Fewshot\\fewshot.db"
  },
  "Fewshot": {
    "Ollama": {
      "BaseUrl": "http://127.0.0.1:11434",
      "EmbeddingModel": "nomic-embed-text",
      "SummarizationModel": "gemma4"
    },
    "EnableSwagger": true,
    "EnableHangfire": true
  },
  "AllowedHosts": "*"
}
