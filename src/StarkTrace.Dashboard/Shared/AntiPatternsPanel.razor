@inject StarkTraceApiClient Api

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_patterns.Count</div>
            <div class="stat-label">Total Anti-Patterns</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_patterns.Select(p => p.Language).Where(l => l != null).Distinct().Count()</div>
            <div class="stat-label">Languages Covered</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_patterns.Count(p => !string.IsNullOrEmpty(p.ErrorCode))</div>
            <div class="stat-label">With Error Codes</div>
        </div>
    </div>

    @foreach (var p in _patterns.OrderByDescending(p => p.CreatedAt))
    {
        <div class="card" style="border-left:3px solid var(--danger)">
            <div class="flex justify-between items-center mb-1">
                <strong>@p.Pattern</strong>
                <div class="flex gap-1">
                    @if (!string.IsNullOrEmpty(p.ErrorCode))
                    {
                        <span class="badge badge-danger">@p.ErrorCode</span>
                    }
                    @if (!string.IsNullOrEmpty(p.Language))
                    {
                        <span class="tag">@p.Language</span>
                    }
                </div>
            </div>
            <p class="text-sm text-muted">@p.Reason</p>
            <div class="flex justify-between items-center mt-1">
                <span class="text-sm text-muted">Session @p.SessionId · @p.CreatedAt.ToString("MMM dd HH:mm")</span>
                <button class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(p.AntiPatternId)">Delete</button>
            </div>
        </div>
    }
}

@code {
    private List<AntiPatternDto> _patterns = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _patterns = await Api.GetAntiPatternsAsync();
        _loading = false;
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await Api.DeleteAntiPatternAsync(id);
            _patterns = _patterns.Where(p => p.AntiPatternId != id).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete error: {ex.Message}");
        }
    }
}
