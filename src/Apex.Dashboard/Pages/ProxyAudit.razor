@page "/proxy-audit"
@using Apex.Dashboard.Services
@inject ApexApiClient Api

<div class="page-header">
    <h1 class="page-title">Proxy Audit</h1>
    <p class="page-subtitle">MCP tool traffic intercepted by Apex.Proxy — findings from outbound arguments and inbound results.</p>
</div>

@if (_error != null)
{
    <div class="alert-error">@_error</div>
}

@if (_stats != null)
{
    <div class="stats-grid" style="margin-bottom:1.5rem">
        <div class="stat-card">
            <div class="stat-value">@_stats.Total</div>
            <div class="stat-label">Total Events</div>
        </div>
        <div class="stat-card stat-card-danger">
            <div class="stat-value" style="color:var(--danger)">@_stats.Redacted</div>
            <div class="stat-label">Redacted</div>
        </div>
        <div class="stat-card stat-card-success">
            <div class="stat-value" style="color:var(--success)">@(_stats.Total - _stats.Redacted)</div>
            <div class="stat-label">Clean</div>
        </div>
        <div class="stat-card stat-card-info">
            <div class="stat-value" style="color:var(--info)">@_stats.LastDay</div>
            <div class="stat-label">Last 24h</div>
        </div>
    </div>

    @if (_stats.TopTypes.Count > 0)
    {
        <div class="card" style="margin-bottom:1.5rem">
            <div class="card-title">Top Finding Types</div>
            <div class="flex gap-1 flex-wrap">
                @foreach (var t in _stats.TopTypes)
                {
                    <span class="badge badge-warning">@t.Type <strong>(@t.Count)</strong></span>
                }
            </div>
        </div>
    }
}

<!-- Filter -->
<div class="card" style="margin-bottom:1rem">
    <div class="flex gap-2 items-center">
        <label class="flex items-center gap-1" style="cursor:pointer">
            <input type="checkbox" @bind="_redactedOnly" @bind:event="oninput" @onchange="LoadLogsAsync" />
            <span class="text-sm">Redacted only</span>
        </label>
        <button class="btn" @onclick="LoadLogsAsync">Refresh</button>
    </div>
</div>

<!-- Logs Table -->
@if (_loading)
{
    <div class="loading">Loading...</div>
}
else if (_logs.Count == 0)
{
    <div class="card">
        <p class="text-muted">No proxy audit events recorded yet. Events appear when Apex.Proxy intercepts MCP tool traffic.</p>
    </div>
}
else
{
    <div class="card" style="padding:0;overflow:hidden">
        <table class="table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Dir</th>
                    <th>Method</th>
                    <th>Findings</th>
                    <th>Types</th>
                    <th>Confidence</th>
                    <th>Redacted</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in _logs)
                {
                    <tr class="@(log.WasRedacted ? "row-redacted" : "")">
                        <td class="text-sm text-muted" style="white-space:nowrap">@log.Timestamp.ToLocalTime().ToString("MM/dd HH:mm:ss")</td>
                        <td>
                            <span class="badge @(log.Direction == "outbound" ? "badge-info" : "badge-purple")">
                                @log.Direction
                            </span>
                        </td>
                        <td style="font-family:monospace;font-size:0.85em">@log.Method</td>
                        <td style="text-align:center">@log.FindingCount</td>
                        <td>
                            @foreach (var type in log.FindingTypes.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge @GetTypeBadgeClass(type)" style="margin-right:4px">@type.Trim()</span>
                            }
                        </td>
                        <td>@log.MaxConfidence.ToString("F2")</td>
                        <td style="text-align:center">
                            @if (log.WasRedacted)
                            {
                                <span class="badge badge-danger">YES</span>
                            }
                        </td>
                        <td class="text-sm text-muted">@log.Source</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="flex gap-1 items-center" style="margin-top:1rem">
        <button class="btn" @onclick="PrevPage" disabled="@(_page <= 1)">Prev</button>
        <span class="text-sm text-muted">Page @_page of @_totalPages (@_total events)</span>
        <button class="btn" @onclick="NextPage" disabled="@(_page >= _totalPages)">Next</button>
    </div>
}

<style>
    .row-redacted { background: rgba(220, 38, 38, 0.06); }
    .stat-card-danger { border-top: 3px solid var(--danger); }
    .stat-card-success { border-top: 3px solid var(--success); }
    .stat-card-info { border-top: 3px solid var(--info); }
</style>

@code {
    private List<ProxyAuditLogDto> _logs = [];
    private ProxyAuditStatsDto? _stats;
    private string? _error;
    private bool _loading;
    private bool _redactedOnly;
    private int _page = 1;
    private int _total;
    private int _totalPages => Math.Max(1, (int)Math.Ceiling(_total / 50.0));

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();
        await LoadLogsAsync();
    }

    private async Task LoadStatsAsync()
    {
        try { _stats = await Api.GetProxyAuditStatsAsync(); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task LoadLogsAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.GetProxyAuditLogsAsync(_page, _redactedOnly);
            if (result != null)
            {
                _logs = result.Logs;
                _total = result.Total;
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    private async Task PrevPage() { if (_page > 1) { _page--; await LoadLogsAsync(); } }
    private async Task NextPage() { if (_page < _totalPages) { _page++; await LoadLogsAsync(); } }

    private static string GetTypeBadgeClass(string type) => type.Trim() switch
    {
        "SSN" or "CreditCard" or "PrivateKey" => "badge-danger",
        "ConnectionString" or "GitHubToken" or "AWSKey" => "badge-warning",
        "BearerToken" or "JwtToken" => "badge-warning",
        "HighEntropySecret" => "badge-purple",
        _ => ""
    };
}
