@page "/"
@inject ApexApiClient Api
@inject ApexSignalRService SignalR
@implements IDisposable

<div class="page-header">
    <h1 class="page-title">APEX Dashboard</h1>
    <p class="page-subtitle">Adaptive Personalized EXperience — System Overview</p>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_sessions.Count</div>
            <div class="stat-label">Total Sessions</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_sessions.Count(s => s.IsConsolidated)</div>
            <div class="stat-label">Consolidated</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_preferences.Count</div>
            <div class="stat-label">Preferences</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_antiPatterns.Count</div>
            <div class="stat-label">Anti-Patterns</div>
        </div>
    </div>

    <!-- Recent Sessions -->
    <div class="card">
        <div class="card-title">Recent Sessions</div>
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Started</th>
                    <th>Status</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sessions.OrderByDescending(s => s.StartTime).Take(10))
                {
                    <tr>
                        <td>@s.SessionId</td>
                        <td class="text-sm text-muted">@s.StartTime.ToString("MMM dd HH:mm")</td>
                        <td>
                            @if (s.IsConsolidated)
                            {
                                <span class="badge badge-success">Consolidated</span>
                            }
                            else if (s.EndTime.HasValue)
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                            else
                            {
                                <span class="badge badge-info">Active</span>
                            }
                        </td>
                        <td class="text-sm">@(s.ConsolidationSummary?.Split('|').FirstOrDefault()?.Trim() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Health -->
    <div class="card">
        <div class="card-title">Service Health</div>
        @if (_health != null)
        {
            <div class="flex flex-wrap gap-1">
                @foreach (var svc in _health.GetServiceStatuses())
                {
                    <span class="badge @(svc.Value == "healthy" ? "badge-success" : svc.Value == "degraded" ? "badge-warning" : "badge-danger")">
                        @svc.Key: @svc.Value
                    </span>
                }
            </div>
        }
    </div>

    <!-- Presidio -->
    <div class="card">
        <div class="card-title" style="display:flex;align-items:center;justify-content:space-between">
            <span>Presidio PII Detection</span>
            <div class="flex gap-1">
                <button class="btn btn-sm" @onclick="PresidioRestartAsync" disabled="@_presidioBusy">Restart</button>
                @if (_presidio?.Status == "Stopped" || _presidio?.Status == "Disabled")
                {
                    <button class="btn btn-sm btn-primary" @onclick="PresidioStartAsync" disabled="@_presidioBusy">Start</button>
                }
                else
                {
                    <button class="btn btn-sm btn-danger" @onclick="PresidioStopAsync" disabled="@_presidioBusy">Stop</button>
                }
            </div>
        </div>
        @if (_presidio != null)
        {
            <div class="flex flex-wrap gap-1 mb-1">
                <span class="badge @(_presidio.Status == "Running" ? "badge-success" : _presidio.Status is "Starting" or "Restarting" ? "badge-warning" : "badge-danger")">
                    @_presidio.Status
                </span>
                @if (_presidio.Pid.HasValue)
                {
                    <span class="badge">PID @_presidio.Pid</span>
                }
                @if (_presidio.RestartCount > 0)
                {
                    <span class="badge badge-warning">@_presidio.RestartCount restarts</span>
                }
            </div>
            @if (_presidio.UptimeSeconds.HasValue)
            {
                var uptime = TimeSpan.FromSeconds(_presidio.UptimeSeconds.Value);
                <div class="text-sm text-muted">Uptime: @uptime.ToString(@"hh\:mm\:ss")</div>
            }
            @if (_presidio.Status == "Disabled")
            {
                <div class="text-sm text-muted mt-1">Python or presidio script not found. Run the installer to enable PII detection.</div>
            }
        }
    </div>
}

@code {
    private List<SessionDto> _sessions = [];
    private List<PreferenceDto> _preferences = [];
    private List<AntiPatternDto> _antiPatterns = [];
    private HealthStatus? _health;
    private PresidioStatusDto? _presidio;
    private bool _loading = true;
    private bool _presidioBusy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = Api.GetSessionsAsync().ContinueWith(t => _sessions = t.Result);
            var t2 = Api.GetPreferencesAsync().ContinueWith(t => _preferences = t.Result);
            var t3 = Api.GetAntiPatternsAsync().ContinueWith(t => _antiPatterns = t.Result);
            var t4 = Api.GetHealthAsync().ContinueWith(t => _health = t.Result);
            var t5 = Api.GetPresidioStatusAsync().ContinueWith(t => _presidio = t.Result);
            await Task.WhenAll(t1, t2, t3, t4, t5);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        _loading = false;

        SignalR.OnSessionUpdate += HandleSessionUpdate;
    }

    private void HandleSessionUpdate(int sessionId, string status, string summary)
    {
        InvokeAsync(async () =>
        {
            var updated = await Api.GetSessionAsync(sessionId);
            if (updated != null)
            {
                var idx = _sessions.FindIndex(s => s.SessionId == sessionId);
                if (idx >= 0) _sessions[idx] = updated;
                else _sessions.Insert(0, updated);
            }
            StateHasChanged();
        });
    }

    private async Task PresidioStartAsync()
    {
        _presidioBusy = true;
        await Api.PresidioStartAsync();
        await Task.Delay(2000);
        _presidio = await Api.GetPresidioStatusAsync();
        _presidioBusy = false;
    }

    private async Task PresidioStopAsync()
    {
        _presidioBusy = true;
        await Api.PresidioStopAsync();
        await Task.Delay(500);
        _presidio = await Api.GetPresidioStatusAsync();
        _presidioBusy = false;
    }

    private async Task PresidioRestartAsync()
    {
        _presidioBusy = true;
        await Api.PresidioRestartAsync();
        await Task.Delay(2500);
        _presidio = await Api.GetPresidioStatusAsync();
        _presidioBusy = false;
    }

    public void Dispose()
    {
        SignalR.OnSessionUpdate -= HandleSessionUpdate;
    }
}
