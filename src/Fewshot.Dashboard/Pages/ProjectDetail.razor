@page "/projects/{ProjectName}"
@inject FewshotApiClient Api

<div class="page-header">
    <h1 class="page-title">@(_project?.DisplayName ?? ProjectName)</h1>
    <p class="page-subtitle">
        <a href="projects">← Projects</a>
        <span class="text-muted"> · Sessions for @(_project?.Name ?? ProjectName)</span>
    </p>
</div>

<ProjectSessionsPanel Project="@ProjectName" />

@code {
    [Parameter] public string ProjectName { get; set; } = "";

    private ProjectDto? _project;

    protected override async Task OnParametersSetAsync()
    {
        var projects = await Api.GetProjectsAsync();
        _project = projects.FirstOrDefault(p => string.Equals(p.Name, ProjectName, StringComparison.OrdinalIgnoreCase));
    }
}
