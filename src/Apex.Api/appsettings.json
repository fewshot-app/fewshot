{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "ConnectionStrings": {
    "ApexDb": "Data Source=%LOCALAPPDATA%\\APEX\\apex.db"
  },
  "Apex": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "EmbeddingModel": "nomic-embed-text",
      "SummarizationModel": "gemma4"
    },
    "Presidio": {
      "BaseUrl": "http://localhost:3000",
      "ScriptPath": "",
      "PythonPath": ""
    },
    "EnableSwagger": true,
    "EnableHangfire": true
  },
  "AllowedHosts": "*"
}
