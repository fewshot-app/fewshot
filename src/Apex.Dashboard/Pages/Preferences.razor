@page "/preferences"
@inject ApexApiClient Api

<div class="page-header">
    <h1 class="page-title">Developer Preferences</h1>
    <p class="page-subtitle">Explicit and inferred coding style, architecture, and tooling preferences</p>
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else if (!_prefs.Any())
{
    <div class="card"><p class="text-muted">No preferences yet. They are inferred automatically during nightly consolidation.</p></div>
}
else
{
    @foreach (var group in _prefs.GroupBy(p => p.Category).OrderBy(g => g.Key))
    {
        <div class="card">
            <div class="card-title">@group.Key</div>
            <table class="table">
                <thead>
                    <tr>
                        <th>Key</th>
                        <th>Value</th>
                        <th style="width:130px">Confidence</th>
                        <th>Source</th>
                        <th style="width:120px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in group.OrderByDescending(p => p.ConfidenceScore))
                    {
                        @if (_editingId == p.PrefId)
                        {
                            <!-- Edit row -->
                            <tr style="background:rgba(99,102,241,0.06)">
                                <td><strong>@p.Key</strong></td>
                                <td>
                                    <input class="search-input" style="width:100%" @bind="_editValue" />
                                </td>
                                <td>
                                    <div class="flex items-center gap-1">
                                        <input type="range" min="0" max="1" step="0.05"
                                               style="width:60px"
                                               value="@_editConfidence"
                                               @oninput="e => _editConfidence = double.Parse(e.Value!.ToString()!)" />
                                        <span class="text-sm text-muted">@_editConfidence.ToString("F2")</span>
                                    </div>
                                </td>
                                <td>
                                    <label class="flex items-center gap-1 text-sm" style="cursor:pointer">
                                        <input type="checkbox" @bind="_editIsExplicit" />
                                        Explicit
                                    </label>
                                </td>
                                <td>
                                    <div class="flex gap-1">
                                        <button class="btn btn-sm btn-primary" @onclick="() => SaveEditAsync(p.PrefId)">Save</button>
                                        <button class="btn btn-sm" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <!-- Normal row -->
                            <tr>
                                <td><strong>@p.Key</strong></td>
                                <td class="text-sm">@p.Value</td>
                                <td>
                                    <div class="flex items-center gap-1">
                                        <div class="progress" style="width:60px">
                                            <div class="progress-bar @ConfidenceBarClass(p.ConfidenceScore)"
                                                 style="width:@((int)(p.ConfidenceScore * 100))%"></div>
                                        </div>
                                        <span class="text-sm text-muted">@p.ConfidenceScore.ToString("F2")</span>
                                    </div>
                                </td>
                                <td>
                                    @if (p.IsExplicit)
                                    {
                                        <span class="badge badge-info">Explicit</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">Inferred</span>
                                        @if (p.SourceSessionId.HasValue)
                                        {
                                            <span class="text-sm text-muted"> S@(p.SourceSessionId)</span>
                                        }
                                    }
                                    @if (p.ReinforcementCount > 1)
                                    {
                                        <span class="text-sm text-muted"> ×@p.ReinforcementCount</span>
                                    }
                                </td>
                                <td>
                                    @if (_confirmDeleteId == p.PrefId)
                                    {
                                        <div class="flex items-center gap-1">
                                            <span class="text-sm text-danger">Sure?</span>
                                            <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDeleteAsync(p.PrefId)">Yes</button>
                                            <button class="btn btn-sm" @onclick="CancelDelete">No</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex gap-1">
                                            <button class="btn btn-sm" @onclick="() => StartEdit(p)">Edit</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RequestDelete(p.PrefId)">Delete</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private List<PreferenceDto> _prefs = [];
    private bool _loading = true;

    private int? _editingId;
    private string _editValue = "";
    private double _editConfidence = 0.5;
    private bool _editIsExplicit;

    private int? _confirmDeleteId;

    protected override async Task OnInitializedAsync()
    {
        _prefs = await Api.GetPreferencesAsync();
        _loading = false;
    }

    private void StartEdit(PreferenceDto p)
    {
        _editingId = p.PrefId;
        _editValue = p.Value;
        _editConfidence = p.ConfidenceScore;
        _editIsExplicit = p.IsExplicit;
        _confirmDeleteId = null;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEditAsync(int prefId)
    {
        try
        {
            var updated = await Api.UpdatePreferenceAsync(prefId, _editValue, _editConfidence, _editIsExplicit);
            if (updated != null)
            {
                var idx = _prefs.FindIndex(p => p.PrefId == prefId);
                if (idx >= 0) _prefs[idx] = updated;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Update error: {ex.Message}");
        }
        _editingId = null;
    }

    private void RequestDelete(int prefId)
    {
        _confirmDeleteId = prefId;
        _editingId = null;
    }

    private void CancelDelete() => _confirmDeleteId = null;

    private async Task ConfirmDeleteAsync(int prefId)
    {
        try
        {
            await Api.DeletePreferenceAsync(prefId);
            _prefs = _prefs.Where(p => p.PrefId != prefId).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete error: {ex.Message}");
        }
        _confirmDeleteId = null;
    }

    private static string ConfidenceBarClass(double score) =>
        score >= 0.8 ? "progress-bar-success" : score >= 0.5 ? "progress-bar-warning" : "progress-bar-danger";
}
