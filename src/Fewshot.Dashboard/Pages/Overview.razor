@page "/"
@inject FewshotApiClient Api
@inject FewshotSignalRService SignalR
@implements IDisposable

<div class="page-header">
    <h1 class="page-title">Fewshot Dashboard</h1>
    <p class="page-subtitle">Context packs &amp; memory for AI agents — System Overview</p>
    @if (!_loading)
    {
        var pending = _sessions.Count(s => s.EndTime.HasValue && !s.IsConsolidated && s.ConsolidationError == null);
        @if (pending > 0)
        {
            <span class="badge badge-warning">Consolidation: @pending pending</span>
        }
    }
</div>

@if (_loading)
{
    <div class="loading">Loading...</div>
}
else
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-value">@_sessions.Count</div>
            <div class="stat-label">Total Sessions</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_sessions.Count(s => s.IsConsolidated)</div>
            <div class="stat-label">Consolidated</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_preferences.Count</div>
            <div class="stat-label">Preferences</div>
        </div>
        <div class="stat-card">
            <div class="stat-value">@_antiPatterns.Count</div>
            <div class="stat-label">Anti-Patterns</div>
        </div>
    </div>

    <!-- Recent Sessions -->
    <div class="card">
        <div class="card-title">Recent Sessions</div>
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Started</th>
                    <th>Status</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _sessions.OrderByDescending(s => s.StartTime).Take(10))
                {
                    <tr>
                        <td>@s.SessionId</td>
                        <td class="text-sm text-muted">@s.StartTime.ToString("MMM dd HH:mm")</td>
                        <td>
                            @if (s.IsConsolidated)
                            {
                                <span class="badge badge-success">Consolidated</span>
                            }
                            else if (s.EndTime.HasValue)
                            {
                                <span class="badge badge-warning">Pending</span>
                            }
                            else
                            {
                                <span class="badge badge-info">Active</span>
                            }
                        </td>
                        <td class="text-sm">@(s.ConsolidationSummary?.Split('|').FirstOrDefault()?.Trim() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Health -->
    <div class="card">
        <div class="card-title">Service Health</div>
        @if (_health != null)
        {
            <div class="flex flex-wrap gap-1">
                @foreach (var svc in _health.GetServiceStatuses())
                {
                    <span class="badge @(svc.Value == "healthy" ? "badge-success" : svc.Value == "degraded" ? "badge-warning" : "badge-danger")">
                        @svc.Key: @svc.Value
                    </span>
                }
            </div>
        }
    </div>

}

@code {
    private List<SessionDto> _sessions = [];
    private List<PreferenceDto> _preferences = [];
    private List<AntiPatternDto> _antiPatterns = [];
    private HealthStatus? _health;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var t1 = Api.GetSessionsAsync().ContinueWith(t => _sessions = t.Result);
            var t2 = Api.GetPreferencesAsync().ContinueWith(t => _preferences = t.Result);
            var t3 = Api.GetAntiPatternsAsync().ContinueWith(t => _antiPatterns = t.Result);
            var t4 = Api.GetHealthAsync().ContinueWith(t => _health = t.Result);
            await Task.WhenAll(t1, t2, t3, t4);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        _loading = false;

        SignalR.OnSessionUpdate += HandleSessionUpdate;
    }

    private void HandleSessionUpdate(int sessionId, string status, string summary)
    {
        InvokeAsync(async () =>
        {
            var updated = await Api.GetSessionAsync(sessionId);
            if (updated != null)
            {
                var idx = _sessions.FindIndex(s => s.SessionId == sessionId);
                if (idx >= 0) _sessions[idx] = updated;
                else _sessions.Insert(0, updated);
            }
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SignalR.OnSessionUpdate -= HandleSessionUpdate;
    }
}
