@page "/settings"
@inject NavigationManager Nav

<div class="page-header">
    <h1 class="page-title">Settings</h1>
    <p class="page-subtitle">Configuration and experimental features</p>
</div>

<TabBar Tabs="Tabs" ActiveKey="@ActiveTab" ActiveKeyChanged="SelectTab" />

@if (ActiveTab == "experiments")
{
    <ExperimentsPanel />
}
else
{
    <div class="card">
        <p class="text-muted">No general settings yet.</p>
    </div>
}

@code {
    private const string DefaultTab = "general";

    private static readonly TabItem[] Tabs =
    [
        new(DefaultTab, "General"),
        new("experiments", "Experiments")
    ];

    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string ActiveTab => Tabs.Any(t => t.Key == Tab) ? Tab! : DefaultTab;

    private void SelectTab(string key) =>
        Nav.NavigateTo(key == DefaultTab ? "/settings" : $"/settings?tab={key}", replace: true);
}
